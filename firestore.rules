rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // Helper Functions
    // =====================================================================

    // A simple function to check if the user is signed in to your app.
    // This is the foundation of our security.
    function isSignedIn() {
      return request.auth != null;
    }

    function isNotAnonymous() {
      return request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function canAccess() {
      return isSignedIn() && isNotAnonymous();
    }

    // =====================================================================
    // Collection Rules
    // =====================================================================

    // --- Rules for the 'players' collection ---
    match /players/{playerName} {

      // READ: Anyone using the app can read player profiles and leaderboards.
      allow get, list: if canAccess();

      // CREATE: A new player can be created by any signed-in user.
      allow create: if canAccess()
            && request.resource.data.name == playerName
            && request.resource.data.games == 0
            && (!('elo' in request.resource.data) || request.resource.data.elo == 1500)
            && request.resource.data.size() <= 3; // Allows optional elo field

      // UPDATE: Allow updates only if the user is signed in and provides valid data types.
      // This prevents users from corrupting their data, e.g., setting ELO to a string.
      allow update: if canAccess()
                    && request.resource.data.name == resource.data.name // Player name cannot be changed
            && (!('elo' in request.resource.data) || request.resource.data.elo is number)
            && request.resource.data.games is number;
    }

    // --- Rules for the 'matches' collection ---
    match /matches/{matchId} {

      // READ: Anyone using the app can read the match history for stats.
      allow get, list: if canAccess();

      // CREATE: Anyone can log a new match, but the data must be valid.
      // This is our most important validation rule.
      allow create: if canAccess()
            && request.resource.data.teamA is list
            && request.resource.data.teamA.size() <= 2 // Allow 1v1 or 2v2
            && request.resource.data.teamB is list
            && request.resource.data.teamB.size() <= 2
            && request.resource.data.winner is string
            && (request.resource.data.winner == 'A' || request.resource.data.winner == 'B')
            && request.resource.data.goalsA is number
            && request.resource.data.goalsB is number
            && (!('eloDelta' in request.resource.data) || request.resource.data.eloDelta is number)
            && request.resource.data.timestamp == request.time
            // Optional tournament fields
            && (!('tournamentId' in request.resource.data) || request.resource.data.tournamentId is string)
            && (!('tournamentGameId' in request.resource.data) || request.resource.data.tournamentGameId is string)
            && (!('tournamentGameName' in request.resource.data) || request.resource.data.tournamentGameName is string);

      // Allow vibration metadata updates OR match edits (with audit trail)
      allow update: if canAccess()
        && (
          // Case 1: Vibration metadata only
          (
            request.resource.data.diff(resource.data).changedKeys().hasOnly(['vibrationLogPath', 'hasVibrationLog'])
            && (!('vibrationLogPath' in request.resource.data) || request.resource.data.vibrationLogPath is string)
            && (!('hasVibrationLog' in request.resource.data) || request.resource.data.hasVibrationLog is bool)
          )
          ||
          // Case 2: Match editing — core fields + audit trail
          (
            request.resource.data.diff(resource.data).changedKeys()
              .hasOnly(['teamA', 'teamB', 'winner', 'goalsA', 'goalsB', 'positionsConfirmed', 'ranked', 'editedAt', 'editHistory', 'goalLog', 'matchDuration', 'deleted', '_rankedBeforeDelete'])
            && request.resource.data.teamA is list
            && request.resource.data.teamA.size() <= 2
            && request.resource.data.teamB is list
            && request.resource.data.teamB.size() <= 2
            && request.resource.data.winner is string
            && (request.resource.data.winner == 'A' || request.resource.data.winner == 'B')
            && request.resource.data.goalsA is number
            && request.resource.data.goalsB is number
            // Timestamp must remain unchanged
            && request.resource.data.timestamp == resource.data.timestamp
            // Audit trail is required
            && 'editedAt' in request.resource.data
            && 'editHistory' in request.resource.data
            && request.resource.data.editHistory is list
          )
        );

      // Matches cannot be deleted from the client.
      allow delete: if false;
    }

    // --- Rules for the 'meta' collection (for session data) ---
    match /meta/{docId} {
      // Allow any signed-in user to read and write session data,
      // like the list of active players for pairing suggestions.
      allow read: if canAccess();
      allow write: if canAccess() && docId != 'currentMatch';
    }

    // Shared live match for betting: never deleted, and betting that closed at the first goal
    // is not reopened unless the match itself is replaced or ended (matchupKey or offer change).
    match /meta/currentMatch {
      allow read, create: if canAccess();
      allow update: if canAccess() && !(
            resource.data.get('firstGoalAt', null) != null
            && request.resource.data.get('firstGoalAt', null) == null
            && request.resource.data.get('matchupKey', null) == resource.data.get('matchupKey', null)
            && request.resource.data.get('offer', null) == resource.data.get('offer', null));
      allow delete: if false;
    }

    // --- Rules for the 'users' collection (notification preferences) ---
    match /users/{userId} {
      allow get, create, update: if canAccess() && request.auth.uid == userId;
      allow list: if false;
    }

    // --- Rules for the 'tournaments' collection ---
    match /tournaments/{tournamentId} {

      // READ: Anyone using the app can read tournament data.
      allow get, list: if canAccess();

      // CREATE: Any signed-in user can create a tournament in setup state.
      allow create: if canAccess()
            && request.resource.data.name is string
            && request.resource.data.state == 'setup'
            && request.resource.data.teams is list;

      // UPDATE: Any signed-in user can update tournaments.
      // State transitions and game results are validated client-side.
      allow update: if canAccess()
            && request.resource.data.name is string
            && request.resource.data.state is string
            && request.resource.data.state in ['setup', 'locked', 'in_progress', 'completed', 'deleted'];

      // Tournaments cannot be hard-deleted.
      allow delete: if false;
    }

    // --- Rules for the 'teams' collection (team names + entrance songs) ---
    match /teams/{teamId} {

      // READ: anyone using the app can read team names/songs.
      allow read: if canAccess();

      // WRITE: any signed-in non-anonymous user can create/update a team record.
      // Validates field types; name/songUri may be null (cleared).
      allow write: if canAccess()
            && request.resource.data.players is list
            && (!('name' in request.resource.data) || request.resource.data.name == null || request.resource.data.name is string)
            && (!('songUri' in request.resource.data) || request.resource.data.songUri == null || request.resource.data.songUri is string)
            && (!('songPositionMs' in request.resource.data) || request.resource.data.songPositionMs is number);
    }

    // --- Rules for the 'bets' collection (golden-football betting) ---
    match /bets/{betId} {
      function currentMatch() {
        return get(/databases/$(database)/documents/meta/currentMatch).data;
      }

      allow get, list: if canAccess();

      function isHouse() { return request.resource.data.kind == 'house'; }
      function isChallenge() { return request.resource.data.kind == 'challenge'; }
      function isName(v) { return v is string && v.size() > 0; }
      // whole golden footballs; the bound keeps Infinity/1e12 out of everyone's balances
      function isStake(v) { return v is int && v > 0 && v <= 10000; }

      // House bets only while the current match has not had its first goal;
      // challenges any time while their matchup is the shared one.
      allow create: if canAccess()
            && request.resource.data.matchupKey is string
            && request.resource.data.matchupKey == currentMatch().matchupKey
            && request.resource.data.placedAt == request.time
            && request.resource.data.void == false
            && request.resource.data.outcome.test is string
            && (
              (isHouse()
                && request.resource.data.keys().hasOnly(['kind', 'matchupKey', 'placedAt', 'outcome', 'void', 'bettor', 'stake', 'odds'])
                && isName(request.resource.data.bettor)
                && isStake(request.resource.data.stake)
                // 10 = BETTING.oddsClamp max; winner odds must be the published ones
                && request.resource.data.odds is number && request.resource.data.odds >= 1 && request.resource.data.odds <= 10
                && currentMatch().firstGoalAt == null
                && currentMatch().offer != null
                && (request.resource.data.outcome.test != 'winner'
                  || request.resource.data.odds in currentMatch().offer.winner.values()))
              ||
              (isChallenge()
                && request.resource.data.keys().hasOnly(['kind', 'matchupKey', 'placedAt', 'outcome', 'void', 'challenger', 'opponent',
                  'challengerStake', 'opponentStake', 'acceptedBy', 'acceptedAt'])
                && isName(request.resource.data.challenger)
                && (request.resource.data.opponent == null
                  || (isName(request.resource.data.opponent) && request.resource.data.opponent != request.resource.data.challenger))
                && isStake(request.resource.data.challengerStake)
                && isStake(request.resource.data.opponentStake)
                // open to accept, or locked in straight away with the named opponent
                && ((request.resource.data.acceptedBy == null && request.resource.data.acceptedAt == null)
                  || (request.resource.data.opponent != null
                    && request.resource.data.acceptedBy == request.resource.data.opponent
                    && request.resource.data.acceptedAt == request.time)))
            );

      allow update: if canAccess() && (
            // undo / withdraw: only voiding; a challenge only while unaccepted, a house bet only
            // shortly after placing (UI undo window is BETTING.undoWindowMs = 5 s; 60 s is slack)
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['void'])
              && request.resource.data.void == true
              && ((resource.data.kind == 'challenge'
                  && (resource.data.acceptedBy == null
                    || (resource.data.acceptedAt == resource.data.placedAt
                      && request.time < resource.data.placedAt + duration.value(60, 's'))))
                || (resource.data.kind == 'house' && request.time < resource.data.placedAt + duration.value(60, 's'))))
            ||
            // accept: once, not withdrawn, by the named opponent (or anyone), not the challenger
            (resource.data.kind == 'challenge'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy', 'acceptedAt'])
              && resource.data.acceptedBy == null
              && resource.data.void == false
              && isName(request.resource.data.acceptedBy)
              && request.resource.data.acceptedBy != resource.data.challenger
              && (resource.data.opponent == null || request.resource.data.acceptedBy == resource.data.opponent)
              && request.resource.data.acceptedAt == request.time
              && currentMatch().matchupKey == resource.data.matchupKey
              // posted before kick-off -> only until the first goal; posted mid-match -> any time
              && (currentMatch().firstGoalAt == null || resource.data.placedAt > currentMatch().firstGoalAt))
          );

      allow delete: if false;
    }
  }
}
